# Apply inside the docs.verifik.co server { } block (or include this file).
# Enables gzip for text assets and Cache-Control for the static Docusaurus build.

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types
	text/plain
	text/css
	text/html
	application/javascript
	application/json
	application/xml
	image/svg+xml;
gzip_vary on;

# Hashed webpack assets — immutable
location /assets/ {
	add_header Cache-Control "public, max-age=31536000, immutable";
	try_files $uri =404;
}

# Lunr search indexes — short edge/browser revalidate
location ~* ^/search-index.*\.json$ {
	add_header Cache-Control "public, max-age=0, must-revalidate";
	default_type application/json;
	try_files $uri =404;
}

# --- PR #99 / issue #1122–#1123 (parity with vercel.json; production uses nginx, not Vercel) ---

# Stale Spanish privacy policy URL: 403 + redirect helper page (issue #1122)
location ~ ^/verifik-llc/politicas-de-privacidad/?$ {
	error_page 403 =403 /redirects/politicas-de-privacidad.html;
	return 403;
}

# SEO slug moves (issue #1123)
location ~ ^/identity/identity-verification/?$ {
	return 301 /identity/ekyc-identity-verification-guide/;
}
location ~ ^/business-validation/business-verification/?$ {
	return 301 /business-validation/kyb-business-verification-guide/;
}
location ~ ^/vehicle-validation/vehicle-verification/?$ {
	return 301 /vehicle-validation/vehicle-data-verification-guide/;
}
location ~ ^/verifik-es/identidad/verificacion-identidad/?$ {
	return 301 /verifik-es/identidad/guia-verificacion-identidad-ekyc/;
}
location ~ ^/verifik-es/validacion-empresarial/verificacion-empresarial/?$ {
	return 301 /verifik-es/validacion-empresarial/guia-verificacion-empresarial-kyb/;
}
location ~ ^/verifik-es/validacion-vehiculos/verificacion-vehiculos/?$ {
	return 301 /verifik-es/validacion-vehiculos/guia-verificacion-vehicular/;
}

# HTML and other static files
location / {
	add_header Cache-Control "public, max-age=0, must-revalidate";
	try_files $uri $uri/ $uri.html /index.html;
}
