{
  "routes": [
    {
      "src": "^/verifik-llc/politicas-de-privacidad/?$",
      "dest": "/redirects/politicas-de-privacidad.html",
      "status": 403
    },
    {
      "src": "^/identity/identity-verification/?$",
      "status": 301,
      "headers": { "Location": "/identity/ekyc-identity-verification-guide/" }
    },
    {
      "src": "^/business-validation/business-verification/?$",
      "status": 301,
      "headers": { "Location": "/business-validation/kyb-business-verification-guide/" }
    },
    {
      "src": "^/vehicle-validation/vehicle-verification/?$",
      "status": 301,
      "headers": { "Location": "/vehicle-validation/vehicle-data-verification-guide/" }
    },
    {
      "src": "^/verifik-es/identidad/verificacion-identidad/?$",
      "status": 301,
      "headers": { "Location": "/verifik-es/identidad/guia-verificacion-identidad-ekyc/" }
    },
    {
      "src": "^/verifik-es/validacion-empresarial/verificacion-empresarial/?$",
      "status": 301,
      "headers": { "Location": "/verifik-es/validacion-empresarial/guia-verificacion-empresarial-kyb/" }
    },
    {
      "src": "^/verifik-es/validacion-vehiculos/verificacion-vehiculos/?$",
      "status": 301,
      "headers": { "Location": "/verifik-es/validacion-vehiculos/guia-verificacion-vehicular/" }
    }
  ]
}
